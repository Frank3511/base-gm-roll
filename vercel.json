{
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.base.org https://base.org https://*.coinbase.com https://coinbase.com"
        }
      ]
    }
  ]
}
